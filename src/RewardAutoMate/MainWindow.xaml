<Window x:Class="RewardAutoMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:BaseWPFControl="https://BaseWPFControl"
        mc:Ignorable="d"
        Width="960"
        Height="760"
        MinWidth="780"
        MinHeight="640"
        Title="RewardAutoMate"
        FontFamily="Consolas, 微软雅黑"
        Background="#FFF2F3F5"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BaseWPFControl;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 卡片容器 -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#FFE0E0E0" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <!-- 四周边距 2，相邻卡片净距 4 -->
                <Setter Property="Margin" Value="2" />
            </Style>

            <!-- 指标小标签 -->
            <Style x:Key="StatLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="#FF8A8A8A" />
            </Style>

            <!-- 指标大数值 -->
            <Style x:Key="StatValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <!-- 任务状态小项 -->
            <Style x:Key="TaskItemStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部标题栏 ============ -->
        <DockPanel Grid.Row="0" Margin="4,0,4,6">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource PrimaryColor}" VerticalAlignment="Center" />
                <TextBlock Text="RewardAutoMate"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF212121"
                           Margin="8,0,0,0" />
                <Separator Style="{StaticResource VerticalSeparatorStyle}" Height="22" Margin="12,0" />
                <Border Background="#FFE3F2FD" CornerRadius="4" Padding="10,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="下次执行:" FontSize="12" Foreground="#FF1976D2" VerticalAlignment="Center" />
                        <TextBlock x:Name="TextBlock_NextRun"
                                   Text="--"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FF0D47A1"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   ToolTip="下次自动执行时间" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <BaseWPFControl:MemoryBlock DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,4,0" />
        </DockPanel>

        <!-- ============ 统计卡片 ============ -->
        <UniformGrid Grid.Row="1" Columns="4" >
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="当前积分" Style="{StaticResource StatLabelStyle}" />
                    <TextBlock x:Name="TextBlock_CurrentPoints" Text="--"
                               Style="{StaticResource StatValueStyle}" Foreground="#FF2196F3" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="可领取" Style="{StaticResource StatLabelStyle}" />
                    <TextBlock x:Name="TextBlock_Claimable" Text="--"
                               Style="{StaticResource StatValueStyle}" Foreground="#FF2196F3" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="今日已获得" Style="{StaticResource StatLabelStyle}" />
                    <TextBlock x:Name="TextBlock_TodayEarned" Text="0"
                               Style="{StaticResource StatValueStyle}" Foreground="#FF2196F3" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="会员等级" Style="{StaticResource StatLabelStyle}" />
                    <TextBlock x:Name="TextBlock_Level" Text="--"
                               Style="{StaticResource StatValueStyle}" Foreground="#FF2196F3" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 搜索进度 ============ -->
        <!-- ============ 搜索进度 ============ -->
        <UniformGrid Grid.Row="2" Columns="2" >
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel >
                        <TextBlock Text="PC 搜索" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center">
                            <TextBlock.ToolTip>
                                <ToolTip>本程序今日执行的 PC 端搜索次数</ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="TextBlock_PcSearch" Text="0 / 0" Style="{StaticResource StatValueStyle}"
                                   Foreground="#FF2196F3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar x:Name="ProgressBar_PcSearch"
                                 Height="18"
                                 Maximum="100"
                                 Value="0"
                                 BaseWPFControl:ControlProperty.CornerRadius="5" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel >
                        <TextBlock Text="Mobile 搜索" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center">
                            <TextBlock.ToolTip>
                                <ToolTip>本程序今日执行的移动端搜索次数</ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="TextBlock_MobileSearch" Text="0 / 0" Style="{StaticResource StatValueStyle}"
                                   Foreground="#FF2196F3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar x:Name="ProgressBar_MobileSearch"
                                 Height="18"
                                 Maximum="100"
                                 Value="0"
                                 BaseWPFControl:ControlProperty.CornerRadius="5" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 任务状态统计（已从界面隐藏，仅保留控件引用供代码更新，需要时可恢复显示） -->
        <Grid Grid.Row="3" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TextBlock_DailySet" />
                <TextBlock x:Name="TextBlock_DashboardSearch" />
                <TextBlock x:Name="TextBlock_DashboardActivity" />
                <TextBlock x:Name="TextBlock_DashboardCheckIn" />
                <TextBlock x:Name="TextBlock_Benefits" />
                <TextBlock x:Name="TextBlock_PunchCards" />
                <TextBlock x:Name="TextBlock_DailyTasks" />
            </StackPanel>
        </Grid>

        <!-- ============ 热力图 ============ -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="执行热力图" Style="{StaticResource StatLabelStyle}" />
                    <TextBlock Text="最近 365 天搜索次数" Style="{StaticResource StatLabelStyle}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
                <Grid x:Name="HeatmapGrid" Height="104" />
            </StackPanel>
        </Border>

        <!-- ============ 实时日志 ============ -->
        <Border Grid.Row="5"
                Style="{StaticResource CardStyle}"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="实时日志" Style="{StaticResource StatLabelStyle}" />
                    <TextBlock x:Name="TextBlock_LogStatus" Text="等待执行..." Style="{StaticResource StatLabelStyle}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>

                <!-- LogView 宿主：运行时挂载 LogBlock.LogView（含日志列表与详情） -->
                <ContentControl x:Name="LogViewHost" Grid.Row="1" />
            </Grid>
        </Border>

        <!-- LogBlock：仅作为 LogView 的提供者与 BaseLogManager 自动订阅源，不参与界面显示 -->
        <BaseWPFControl:LogBlock x:Name="LogBlock" Visibility="Collapsed" Grid.Row="0" />

        <!-- ============ 底部操作栏 ============ -->
        <DockPanel Grid.Row="6" Margin="4,10,4,0">
            <Button x:Name="Button_SendReport"
                    DockPanel.Dock="Right"
                    Style="{StaticResource BlueButtonStyle}"
                    Content="发送周报"
                    Padding="20,6"
                    FontSize="13"
                    Width="Auto"
                    Height="Auto"
                    Click="Button_SendReport_Click" />
            <Button x:Name="Button_Log"
                    DockPanel.Dock="Right"
                    Style="{StaticResource BlueButtonStyle}"
                    Content="手动执行"
                    Padding="20,6"
                    FontSize="13"
                    Width="Auto"
                    Height="Auto"
                    Margin="0,0,8,0"
                    Click="Button_Task_Click" />
            <TextBlock Text="提示: 程序会自动按计划执行搜索与 Dashboard 任务；可手动执行一次，或立即生成并发送本周执行汇总邮件。"
                       Style="{StaticResource StatLabelStyle}"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
